---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'eventos'>['data'] & {
  backHref: string;
  backLabel: string;
};

const {
  title,
  description,
  eventDate,
  heroImage,
  location,
  registrationUrl,
  backHref,
  backLabel,
} = Astro.props;

const formattedDate = new Date(eventDate).toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});

const today = new Date();
today.setHours(0, 0, 0, 0);
const isUpcoming = new Date(eventDate).getTime() >= today.getTime();
const statusLabel = isUpcoming ? 'Inscrições abertas' : 'Encerrado';
---

<html lang="pt-BR">
  <head>
    <BaseHead title={title} description={description} image={heroImage} />
  </head>

  <body>
    <Header />
    <main>
      <article>

        <a href={backHref} class="back-link">{backLabel}</a>

        <div class="post-header">
          <div class="meta-row">
            <p class="post-date">{formattedDate}</p>
            <span class={`status-badge ${isUpcoming ? 'status-upcoming' : 'status-past'}`}>
              {statusLabel}
            </span>
          </div>
          <h1>{title}</h1>
          <p class="post-location">📍 {location}</p>
        </div>

        {heroImage && (
          <img class="hero-image" src={heroImage} alt={title} />
        )}

        {isUpcoming && registrationUrl && (
          <a href={registrationUrl} target="_blank" class="registration-btn">
            Quero participar
          </a>
        )}

        <div class="prose">
          <slot />
        </div>

      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 2.5rem;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--text);
  }

  .post-header {
    margin-bottom: 2rem;
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .post-date {
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  .status-badge {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--border2);
  }

  .status-upcoming {
    color: #4ade80;
    border-color: rgba(74, 222, 128, 0.4);
    background: rgba(74, 222, 128, 0.1);
  }

  .status-past {
    color: var(--muted);
  }

  .post-header h1 {
    font-size: 1.75rem;
    line-height: 1.3;
    letter-spacing: -0.02em;
    text-transform: none;
    margin-bottom: 0.5rem;
  }

  .post-location {
    font-size: 13px;
    color: var(--muted);
  }

  .hero-image {
    width: 100%;
    aspect-ratio: 16 / 7;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--border);
    margin-bottom: 1.5rem;
    display: block;
  }

  .registration-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 600;
    padding: 0.65rem 1.5rem;
    border-radius: 6px;
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    margin-bottom: 2rem;
    transition: opacity 0.2s;
  }

  .registration-btn:hover {
    opacity: 0.85;
  }

  .prose {
    font-size: 16px;
    line-height: 1.85;
    margin-bottom: 3rem;
  }
</style>
