---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const articles = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead title={`Blog · ${SITE_TITLE}`} description="Métodos de estudo, aprendizado e produtividade para quem está migrando ou evoluindo em programação." />
  </head>
  <body>
    <Header />
    <main>

      <div class="welcome">
        <h1>Blog</h1>
      </div>

      {articles.length > 0 ? (
        <section class="posts-list">
          {articles.map((article) => (
            <a href={`/blog/${article.id}/`} class="post-card">
              {article.data.heroImage && (
                <img
                  class="post-cover"
                  src={article.data.heroImage}
                  alt={article.data.title}
                />
              )}
              <p class="post-date">
                {new Date(article.data.pubDate).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })}
              </p>
              <p class="post-title">{article.data.title}</p>
              <p class="post-summary">{article.data.description}</p>
            </a>
          ))}
        </section>
      ) : (
        <p class="empty-state">Em breve os primeiros artigos por aqui. 🚧</p>
      )}

    </main>
    <Footer />
  </body>
</html>

<style>
  .welcome {
    margin-bottom: 2.5rem;
  }

  .welcome h1 {
    font-size: 1.75rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
    text-transform: none;
    color: var(--text);
  }

  .welcome p {
    color: var(--muted);
    font-size: 15px;
    max-width: 560px;
    margin: 0;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .post-card {
    display: block;
    text-decoration: none;
  }

  .post-card:hover .post-title {
    color: var(--accent2);
  }

  .post-cover {
    width: 100%;
    aspect-ratio: 16 / 7;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--border);
    margin-bottom: 1rem;
    display: block;
    transition: opacity 0.2s;
  }

  .post-card:hover .post-cover {
    opacity: 0.85;
  }

  .post-date {
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 0.4rem;
    letter-spacing: 0.02em;
  }

  .post-title {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.5rem;
    line-height: 1.35;
    transition: color 0.2s;
    text-transform: none;
    letter-spacing: normal;
  }

  .post-summary {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.7;
    margin: 0;
  }

  .empty-state {
    color: var(--muted);
    font-size: 14px;
  }
</style>
