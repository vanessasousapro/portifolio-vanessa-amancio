---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const eventos = (await getCollection('eventos')).sort(
  (a, b) => b.data.eventDate.valueOf() - a.data.eventDate.valueOf(),
);

const today = new Date();
today.setHours(0, 0, 0, 0);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead title={`Eventos · ${SITE_TITLE}`} description="Eventos, encontros e comunidades tech que participo ou organizo." />
  </head>
  <body>
    <Header />
    <main>

      <div class="welcome">
        <h1>Eventos</h1>
      </div>

      {eventos.length > 0 ? (
        <section class="events-list">
          {eventos.map((evento) => {
            const isUpcoming = evento.data.eventDate.getTime() >= today.getTime();
            return (
              <a href={`/eventos/${evento.id}/`} class="event-card">
                {evento.data.heroImage && (
                  <img
                    class="event-cover"
                    src={evento.data.heroImage}
                    alt={evento.data.title}
                  />
                )}
                <div class="event-meta-row">
                  <p class="event-date">
                    {evento.data.eventDate.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })}
                  </p>
                  <span class={`status-badge ${isUpcoming ? 'status-upcoming' : 'status-past'}`}>
                    {isUpcoming ? 'Inscrições abertas' : 'Encerrado'}
                  </span>
                  {evento.data.international && (
                    <span class="international-badge">🌎 Internacional</span>
                  )}
                </div>
                <p class="event-title">{evento.data.title}</p>
                <p class="event-location">📍 {evento.data.location}</p>
                <p class="event-summary">{evento.data.description}</p>
              </a>
            );
          })}
        </section>
      ) : (
        <p class="empty-state">Em breve os próximos eventos por aqui. 🚧</p>
      )}

    </main>
    <Footer />
  </body>
</html>

<style>
  .welcome {
    margin-bottom: 2.5rem;
  }

  .welcome h1 {
    font-size: 1.75rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
    text-transform: none;
    color: var(--text);
  }

  .welcome p {
    color: var(--muted);
    font-size: 15px;
    max-width: 560px;
    margin: 0;
  }

  .events-list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .event-card {
    display: block;
    text-decoration: none;
  }

  .event-card:hover .event-title {
    color: var(--accent2);
  }

  .event-cover {
    width: 100%;
    aspect-ratio: 16 / 7;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--border);
    margin-bottom: 1rem;
    display: block;
    transition: opacity 0.2s;
  }

  .event-card:hover .event-cover {
    opacity: 0.85;
  }

  .event-meta-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.4rem;
  }

  .event-date {
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  .status-badge {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--border2);
  }

  .status-upcoming {
    color: #4ade80;
    border-color: rgba(74, 222, 128, 0.4);
    background: rgba(74, 222, 128, 0.1);
  }

  .status-past {
    color: var(--muted);
  }

  .international-badge {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--border2);
    color: var(--accent2);
  }

  .event-title {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.35rem;
    line-height: 1.35;
    transition: color 0.2s;
    text-transform: none;
    letter-spacing: normal;
  }

  .event-location {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }

  .event-summary {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.7;
    margin: 0 0 0.35rem;
  }

  .event-summary:last-child {
    margin-bottom: 0;
  }

  .empty-state {
    color: var(--muted);
    font-size: 14px;
  }
</style>
